# Dependencies
node_modules/

# Build output
dist/
.vite/

# Env (keep .env.example tracked)
.env
.env.local
.env.*.local
.env.deploy

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Coverage
coverage/
data/geojsons/

# DB dumps — local snapshots, not for git. Keep `scripts/db/*` tracked.
backups/
*.sql.bak

# On-demand Sentinel-2 analysis cache. Keyed by request hash, written
# by scripts/python/sentinel_analysis.py and served via
# /api/analysis/cog/<hash>/<name>. Regenerable by re-posting the same
# AOI + windows + index, so there's no reason to commit the COGs.
data/rasters/analysis/

# SSH keys — should live under ~/.ssh, never in the repo. Belt-and-
# suspenders in case someone runs ssh-keygen with a relative filename.
id_ed25519*
id_rsa*
*ssh_key*
*.pem

# Python (auxiliary scripts under scripts/python/)
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/